# Stage 1: Build client
FROM node:18-alpine AS frontend-builder
WORKDIR /usr/src/app/client

COPY client/package*.json ./
RUN npm install --legacy-peer-deps --production

COPY client/ ./
RUN chmod +x ./node_modules/.bin/react-scripts && npm run build

# Stage 2: Build backend and serve static files
FROM node:18-alpine AS backend-builder
WORKDIR /usr/src/app

RUN apk add --no-cache postgresql-client curl

COPY package*.json ./
RUN npm install --legacy-peer-deps --production

COPY server/ ./server
COPY shared/ ./shared
COPY --from=frontend-builder /usr/src/app/client/build ./client/build

RUN npm install -g serve

RUN chmod +x server/scripts/setup-db.sh 2>/dev/null || true
RUN sed -i 's/\r//' server/scripts/setup-db.sh 2>/dev/null || true

EXPOSE 3000 5000

CMD ["sh", "-c", "server/scripts/setup-db.sh || echo 'WARN: setup-db завершился с ошибкой'; node server/server.js & serve -s client/build -l 3000"]
