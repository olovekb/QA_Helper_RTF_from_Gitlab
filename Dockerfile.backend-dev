# Образ только для бэкенда (разработка)
FROM node:18-alpine

WORKDIR /usr/src/app

# Установка системных зависимостей для БД и OCR
RUN apk add --no-cache postgresql-client python3 py3-pip && \
    ln -sf python3 /usr/bin/python && \
    pip install --no-cache-dir openai Pillow httpx --break-system-packages

# Установка зависимостей Node.js
COPY package*.json ./
RUN npm install --legacy-peer-deps --production

# Копирование исходников бэкенда
COPY server/ ./server

# Настройка скриптов
RUN chmod +x server/scripts/setup-db.sh 2>/dev/null || true
RUN sed -i 's/\r//' server/scripts/setup-db.sh 2>/dev/null || true

EXPOSE 5000

# Запуск только бэкенда
CMD ["sh", "-c", "server/scripts/setup-db.sh || echo 'WARN: setup-db failed'; node server/server.js"]
