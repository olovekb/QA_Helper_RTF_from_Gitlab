{
    "name": "tia-mapping-service",
    "version": "1.0.0",
    "type": "module",
    "description": "Микросервис для анализа влияния тестов (TIA), маппинга компонентов фронтенда/бэкенда и генерации тест-планов для интеграции с Allure",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "concurrently \"nodemon server.js\" \"cd client && npm start\"",
        "build:client": "cd client && npm run build",
        "test": "jest",
        "migrate": "node -r dotenv/config db/knexfile.js && npx knex migrate:latest --knexfile db/knexfile.js",
        "setup-db": "./scripts/setup-db.sh"
    },
    "keywords": [
        "tia",
        "test-impact-analysis",
        "allure",
        "mapping",
        "microservice"
    ],
    "author": "Your Name",
    "license": "MIT",
    "dependencies": {
        "axios": "^1.8.1",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.18.2",
        "joi": "^17.12.3",
        "knex": "^3.1.0",
        "multer": "^1.4.5-lts.1",
        "mysql2": "^3.12.0",
        "node-fetch": "^3.3.2",
        "pg": "^8.13.3",
        "winston": "^3.17.0"
    },
    "devDependencies": {
        "concurrently": "^8.2.2",
        "jest": "^29.7.0",
        "nodemon": "^3.1.0"
    }
}
